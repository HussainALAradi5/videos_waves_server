NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/videos_waves
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Public origin used to build media URLs returned to clients
PUBLIC_BASE_URL=http://localhost:5000
STORAGE_VIDEOS_DIR=storage/videos
UPLOAD_MAX_VIDEO_MB=100
# Development seed passwords (leave empty to generate random ones into .seed-credentials.local.json)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
